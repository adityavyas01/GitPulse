NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://gitpulse:gitpulse@localhost:5433/gitpulse

# Redis
REDIS_URL=redis://localhost:6379

# GitHub ingestion (server-side only; never exposed to the frontend)
# Optional: personal access token increases rate limits
GITHUB_TOKEN=
# Optional: override for testing
GITHUB_API_URL=https://api.github.com
GITHUB_MIN_POLL_INTERVAL_MS=60000
GITHUB_MAX_RETRIES=3
GITHUB_RETRY_BASE_DELAY_MS=500
GITHUB_REQUEST_TIMEOUT_MS=15000
